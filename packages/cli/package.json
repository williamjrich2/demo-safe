{
  "name": "@demo-safe/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "demo-safe": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "demo-safe": "tsx src/index.ts"
  },
  "dependencies": {
    "@demo-safe/core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
